{
  "index_patterns": ["lab-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "winlog_event_data_as_keyword": {
            "path_match": "winlog.event_data.*",
            "mapping": { "type": "keyword", "ignore_above": 2048 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "event": {
          "properties": {
            "code": { "type": "keyword" },
            "action": { "type": "keyword" },
            "category": { "type": "keyword" },
            "type": { "type": "keyword" },
            "outcome": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "module": { "type": "keyword" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "keyword" },
            "os": {
              "properties": {
                "type": { "type": "keyword" },
                "platform": { "type": "keyword" }
              }
            }
          }
        },
        "user": {
          "properties": {
            "name": { "type": "keyword" },
            "id": { "type": "keyword" },
            "domain": { "type": "keyword" }
          }
        },
        "service": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "process": {
          "type": "object",
          "subobjects": false,
          "properties": {
            "name": { "type": "keyword" },
            "executable": { "type": "keyword" },
            "executable.caseless": { "type": "keyword" },
            "command_line": { "type": "wildcard" },
            "pid": { "type": "long" },
            "parent": {
              "type": "object",
              "subobjects": false,
              "properties": {
                "name": { "type": "keyword" },
                "executable": { "type": "keyword" },
                "executable.caseless": { "type": "keyword" },
                "command_line": { "type": "wildcard" },
                "pid": { "type": "long" }
              }
            }
          }
        },
        "file": {
          "properties": {
            "path": { "type": "keyword" },
            "name": { "type": "keyword" },
            "directory": { "type": "keyword" }
          }
        },
        "registry": {
          "properties": {
            "path": { "type": "keyword" },
            "value": { "type": "wildcard" },
            "hive": { "type": "keyword" }
          }
        },
        "dns": {
          "properties": {
            "question": {
              "properties": {
                "name": { "type": "keyword" },
                "type": { "type": "keyword" }
              }
            }
          }
        },
        "cloud": {
          "properties": {
            "provider": { "type": "keyword" },
            "region": { "type": "keyword" },
            "account": {
              "properties": {
                "id": { "type": "keyword" }
              }
            }
          }
        },
        "network": {
          "properties": {
            "direction": { "type": "keyword" },
            "transport": { "type": "keyword" },
            "protocol": { "type": "keyword" },
            "bytes": { "type": "long" }
          }
        },
        "source": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" }
          }
        },
        "destination": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" }
          }
        },
        "url": {
          "properties": {
            "path": { "type": "keyword" },
            "query": { "type": "keyword" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "long" },
                "bytes": { "type": "long" }
              }
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "winlog": {
          "properties": {
            "channel": { "type": "keyword" },
            "event_id": { "type": "keyword" },
            "computer_name": { "type": "keyword" },
            "provider_name": { "type": "keyword" },
            "event_data": { "type": "object", "dynamic": true }
          }
        },
        "message": { "type": "wildcard" }
      }
    }
  }
}
